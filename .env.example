# Copy to .env and edit. Never commit .env.

# Port the server listens on (binds to 0.0.0.0 so phones on the LAN can join)
PORT=3000

# Username that becomes admin when registered. Leave empty: the first registered account is admin.
ADMIN_USERNAME=

# Optional: where the SQLite DB and backups live (relative to the repo root)
# KH_DATA_DIR=server/data
# KH_BACKUP_DIR=server/backups
